# Copy this file to .env.local and fill in the values from
# Supabase -> Project Settings -> API. Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose this in the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: WhatsApp alert to the office when an enquiry or job application arrives ---
# Leave WHATSAPP_PROVIDER empty to switch alerts off. See "WhatsApp alerts" in README.md.
WHATSAPP_PROVIDER=            # cloud (official Meta API) or callmebot (free, personal number)
WHATSAPP_TO=                  # who gets the alert: country code + number, comma separated, e.g. 919771020700

# provider = cloud
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=       # approved template with ONE variable, e.g. school_alert
WHATSAPP_TEMPLATE_LANG=en

# provider = callmebot
CALLMEBOT_API_KEY=

# Public address of the site (used in alerts, sitemap and share links). Set to the custom domain once live.
NEXT_PUBLIC_SITE_URL=https://laurels-global-school.vercel.app

# Optional: the ownership code from Google Search Console ("HTML tag" method)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
